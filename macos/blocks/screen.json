{
 "about": "the elements of the screen designer (the \"screen\" page of the script builder): what each draws, its properties, and how a number property can move. macos/blocks/screen.js turns a design into Lua; the designer (designer.js) edits it.",
 "version": 1,
 "screen": {"width": 128, "height": 64},
 "groups": [
  {"name": "shapes", "label": "shapes"},
  {"name": "values", "label": "values"},
  {"name": "moving", "label": "moving"}
 ],
 "elements": [
  {"type": "text", "label": "text", "group": "shapes", "box": "text",
   "about": "words; {tempo}, {note}, {beat}, {step}, {page} and {control name} show live values",
   "props": [
    {"name": "text", "label": "text", "type": "text", "default": "hello {note}"},
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 4},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 12},
    {"name": "size", "label": "size", "type": "number", "min": 6, "max": 48, "default": 8, "step": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1},
    {"name": "align", "label": "align", "type": "choice", "options": ["left", "centre", "right"], "default": "left"}]},
  {"type": "rect", "label": "rectangle", "group": "shapes", "box": "rect",
   "about": "a box, filled or outlined",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 10},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 10},
    {"name": "w", "label": "width", "type": "number", "min": 1, "max": 128, "default": 30},
    {"name": "h", "label": "height", "type": "number", "min": 1, "max": 64, "default": 16},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 8, "step": 1},
    {"name": "fill", "label": "drawn", "type": "choice", "options": ["filled", "outlined"], "default": "outlined"}]},
  {"type": "circle", "label": "circle", "group": "shapes", "box": "circle",
   "about": "a circle, filled or outlined",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "radius", "type": "number", "min": 1, "max": 64, "default": 12},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1},
    {"name": "fill", "label": "drawn", "type": "choice", "options": ["filled", "outlined"], "default": "outlined"}]},
  {"type": "line", "label": "line", "group": "shapes", "box": "line",
   "about": "a line from one point to another",
   "props": [
    {"name": "x1", "label": "from x", "type": "number", "min": 0, "max": 127, "default": 10},
    {"name": "y1", "label": "from y", "type": "number", "min": 0, "max": 63, "default": 50},
    {"name": "x2", "label": "to x", "type": "number", "min": 0, "max": 127, "default": 118},
    {"name": "y2", "label": "to y", "type": "number", "min": 0, "max": 63, "default": 50},
    {"name": "width", "label": "thickness", "type": "number", "min": 1, "max": 6, "default": 1, "step": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 10, "step": 1}]},
  {"type": "arc", "label": "arc", "group": "shapes", "box": "circle",
   "about": "part of a ring: from 0 (the top) round to 1",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "radius", "type": "number", "min": 1, "max": 64, "default": 20},
    {"name": "from", "label": "from", "type": "number", "min": 0, "max": 1, "default": 0},
    {"name": "to", "label": "to", "type": "number", "min": 0, "max": 1, "default": 0.75},
    {"name": "width", "label": "thickness", "type": "number", "min": 1, "max": 6, "default": 2, "step": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 12, "step": 1}]},

  {"type": "bar", "label": "meter", "group": "values", "box": "rect",
   "about": "a bar filled as far as its value (0 to 1): give it a control, the sound level or the beat",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 10},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 54},
    {"name": "w", "label": "width", "type": "number", "min": 2, "max": 128, "default": 108},
    {"name": "h", "label": "height", "type": "number", "min": 2, "max": 64, "default": 4},
    {"name": "value", "label": "value", "type": "number", "min": 0, "max": 1, "default": 0.5, "animate": "level"},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 12, "step": 1},
    {"name": "dir", "label": "direction", "type": "choice", "options": ["across", "up"], "default": "across"}]},
  {"type": "dial", "label": "dial", "group": "values", "box": "square",
   "about": "the norns dial of a control, with its name and value",
   "props": [
    {"name": "control", "label": "control", "type": "control", "default": "cutoff"},
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 6},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 16},
    {"name": "size", "label": "size", "type": "number", "min": 12, "max": 40, "default": 22, "step": 1}]},
  {"type": "slider", "label": "slider", "group": "values", "box": "rect",
   "about": "the norns slider of a control",
   "props": [
    {"name": "control", "label": "control", "type": "control", "default": "cutoff"},
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 118},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 10},
    {"name": "w", "label": "width", "type": "number", "min": 2, "max": 128, "default": 3, "step": 1},
    {"name": "h", "label": "height", "type": "number", "min": 2, "max": 64, "default": 40, "step": 1},
    {"name": "dir", "label": "direction", "type": "choice", "options": ["up", "across"], "default": "up"}]},
  {"type": "waveform", "label": "looper wave", "group": "values", "box": "rect",
   "about": "the loop of a looper (set up in the blocks), with its playhead",
   "props": [
    {"name": "looper", "label": "looper", "type": "number", "min": 1, "max": 6, "default": 1, "step": 1},
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 0},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 20},
    {"name": "w", "label": "width", "type": "number", "min": 8, "max": 128, "default": 128, "step": 1},
    {"name": "h", "label": "height", "type": "number", "min": 4, "max": 64, "default": 28, "step": 1}]},
  {"type": "steps", "label": "steps", "group": "values", "box": "rect",
   "about": "a row of steps, the current one bright: the counter of a sequence (a variable of the blocks)",
   "props": [
    {"name": "var", "label": "step variable", "type": "text", "default": "step"},
    {"name": "count", "label": "steps", "type": "number", "min": 2, "max": 32, "default": 16, "step": 1},
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 4},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 56},
    {"name": "w", "label": "width", "type": "number", "min": 8, "max": 128, "default": 120, "step": 1},
    {"name": "h", "label": "height", "type": "number", "min": 2, "max": 32, "default": 4, "step": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1}]},

  {"type": "rings", "label": "rings on notes", "group": "moving", "box": "circle",
   "about": "every note sends a ring out from the centre, fading as it grows",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "reach", "type": "number", "min": 4, "max": 90, "default": 40},
    {"name": "time", "label": "lasts", "type": "number", "min": 0.1, "max": 4, "default": 1, "units": "s"},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1}]},
  {"type": "sparks", "label": "sparks on notes", "group": "moving", "box": "circle",
   "about": "every note throws sparks that fall and fade",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "spread", "type": "number", "min": 4, "max": 90, "default": 30},
    {"name": "count", "label": "sparks", "type": "number", "min": 1, "max": 40, "default": 12, "step": 1},
    {"name": "gravity", "label": "gravity", "type": "number", "min": 0, "max": 100, "default": 40},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1}]},
  {"type": "orbit", "label": "orbit", "group": "moving", "box": "circle",
   "about": "dots going round, once every so many beats",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "radius", "type": "number", "min": 2, "max": 64, "default": 20},
    {"name": "dots", "label": "dots", "type": "number", "min": 1, "max": 16, "default": 3, "step": 1},
    {"name": "beats", "label": "round in", "type": "number", "min": 0.25, "max": 32, "default": 4, "units": "beats"},
    {"name": "size", "label": "dot size", "type": "number", "min": 1, "max": 8, "default": 2},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1}]},
  {"type": "wave", "label": "wave", "group": "moving", "box": "full",
   "about": "a sine line across the screen, flowing with the beat",
   "props": [
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "height", "label": "height", "type": "number", "min": 0, "max": 32, "default": 10, "animate": "level"},
    {"name": "cycles", "label": "waves", "type": "number", "min": 0.5, "max": 8, "default": 2},
    {"name": "beats", "label": "flows in", "type": "number", "min": 0.25, "max": 32, "default": 2, "units": "beats"},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 10, "step": 1}]},
  {"type": "spiral", "label": "spiral", "group": "moving", "box": "circle",
   "about": "a turning spiral",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 64},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 32},
    {"name": "r", "label": "size", "type": "number", "min": 4, "max": 64, "default": 28},
    {"name": "turns", "label": "turns", "type": "number", "min": 1, "max": 8, "default": 3},
    {"name": "beats", "label": "turns in", "type": "number", "min": 0.25, "max": 32, "default": 8, "units": "beats"},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 8, "step": 1}]},
  {"type": "lissajous", "label": "lissajous", "group": "moving", "box": "rect",
   "about": "the figure two waves draw together, slowly turning",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 34},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 4},
    {"name": "w", "label": "width", "type": "number", "min": 8, "max": 128, "default": 60},
    {"name": "h", "label": "height", "type": "number", "min": 8, "max": 64, "default": 56},
    {"name": "a", "label": "across", "type": "number", "min": 1, "max": 7, "default": 3, "step": 1},
    {"name": "b", "label": "up", "type": "number", "min": 1, "max": 7, "default": 2, "step": 1},
    {"name": "beats", "label": "turns in", "type": "number", "min": 0.25, "max": 32, "default": 8, "units": "beats"},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 10, "step": 1}]},
  {"type": "stars", "label": "stars", "group": "moving", "box": "full",
   "about": "flying through stars",
   "props": [
    {"name": "count", "label": "stars", "type": "number", "min": 5, "max": 120, "default": 40, "step": 1},
    {"name": "speed", "label": "speed", "type": "number", "min": 0, "max": 4, "default": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 12, "step": 1}]},
  {"type": "rain", "label": "rain", "group": "moving", "box": "full",
   "about": "falling drops",
   "props": [
    {"name": "count", "label": "drops", "type": "number", "min": 5, "max": 120, "default": 30, "step": 1},
    {"name": "speed", "label": "speed", "type": "number", "min": 0, "max": 4, "default": 1},
    {"name": "length", "label": "length", "type": "number", "min": 1, "max": 12, "default": 3, "step": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 6, "step": 1}]},
  {"type": "noise", "label": "snow", "group": "moving", "box": "rect",
   "about": "flickering pixels, like an old screen",
   "props": [
    {"name": "x", "label": "x", "type": "number", "min": 0, "max": 127, "default": 0},
    {"name": "y", "label": "y", "type": "number", "min": 0, "max": 63, "default": 0},
    {"name": "w", "label": "width", "type": "number", "min": 1, "max": 128, "default": 128, "step": 1},
    {"name": "h", "label": "height", "type": "number", "min": 1, "max": 64, "default": 64, "step": 1},
    {"name": "density", "label": "density", "type": "number", "min": 0, "max": 1, "default": 0.05},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 3, "step": 1}]},
  {"type": "bounce", "label": "bouncing ball", "group": "moving", "box": "full",
   "about": "a ball bouncing off the edges",
   "props": [
    {"name": "size", "label": "size", "type": "number", "min": 1, "max": 16, "default": 3},
    {"name": "speed", "label": "speed", "type": "number", "min": 0, "max": 4, "default": 1},
    {"name": "level", "label": "brightness", "type": "number", "min": 0, "max": 15, "default": 15, "step": 1}]}
 ],
 "common": [
  {"name": "page", "label": "page", "type": "number", "min": 0, "max": 8, "default": 0, "step": 1, "about": "0: every page; 1 and up: only on that page (the blocks choose the page)"}
 ],
 "animations": [
  {"kind": "beat", "label": "with the beat", "about": "goes from \"from\" to \"to\" and back, in time with the clock",
   "fields": [
    {"name": "beats", "label": "every", "type": "number", "min": 0.25, "max": 64, "default": 4, "units": "beats"},
    {"name": "shape", "label": "shape", "type": "choice", "options": ["sine", "triangle", "saw", "square", "random"], "default": "sine"}]},
  {"kind": "time", "label": "over time", "about": "the same, in seconds, whatever the tempo",
   "fields": [
    {"name": "seconds", "label": "every", "type": "number", "min": 0.1, "max": 60, "default": 2, "units": "s"},
    {"name": "shape", "label": "shape", "type": "choice", "options": ["sine", "triangle", "saw", "square", "random"], "default": "sine"}]},
  {"kind": "note", "label": "on each note", "about": "jumps to \"to\" when a note plays, then glides back to \"from\"",
   "fields": [
    {"name": "decay", "label": "back in", "type": "number", "min": 0.05, "max": 4, "default": 0.5, "units": "s"}]},
  {"kind": "level", "label": "with the sound level", "about": "\"from\" when silent, \"to\" when loud",
   "fields": []},
  {"kind": "control", "label": "with a control", "about": "\"from\" at the control's lowest, \"to\" at its highest",
   "fields": [
    {"name": "control", "label": "control", "type": "control", "default": "cutoff"}]},
  {"kind": "looper", "label": "with a looper's playhead", "about": "\"from\" at the start of the loop, \"to\" at its end",
   "fields": [
    {"name": "looper", "label": "looper", "type": "number", "min": 1, "max": 6, "default": 1, "step": 1}]}
 ]
}
