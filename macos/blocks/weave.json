{
 "about": "the modules of Weave, the modular engine of the script builder (sc/engines/WeaveGraph.sc). one source for the patcher, the Lua the builder writes and the engine tests. option params are sent to the engine as 0-based numbers.",
 "version": 1,
 "voice": [
  {"type": "voice", "label": "voice", "group": "fixed", "about": "what each played note gives the patch: its pitch, its gate (held or not), its velocity and a random number of its own",
   "inputs": [],
   "outputs": [{"name": "pitch", "label": "pitch (Hz)"}, {"name": "gate", "label": "gate"}, {"name": "vel", "label": "velocity"}, {"name": "random", "label": "random"}],
   "params": [
    {"name": "voices", "label": "voices", "min": 1, "max": 16, "default": 8, "warp": "lin", "step": 1},
    {"name": "mode", "label": "mode", "options": ["poly", "mono", "legato"], "default": 0},
    {"name": "glide", "label": "glide", "min": 0, "max": 2, "default": 0, "warp": "lin", "units": "s"},
    {"name": "bend", "label": "bend", "min": -12, "max": 12, "default": 0, "warp": "lin", "units": "st"}]},
  {"type": "out", "label": "output", "group": "fixed", "about": "where the sound of a voice leaves the patch, into the effects",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}, {"name": "pan", "label": "pan", "default": "zero"}],
   "outputs": [],
   "params": [
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 0.5, "warp": "lin"},
    {"name": "pan", "label": "pan", "min": -1, "max": 1, "default": 0, "warp": "lin"},
    {"name": "spread", "label": "spread", "min": 0, "max": 1, "default": 0, "warp": "lin"}]},

  {"type": "osc", "label": "oscillator", "group": "source", "about": "sine, triangle, saw or square; fm bends its pitch by the fm input",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}, {"name": "fm", "label": "fm", "default": "zero"}, {"name": "pwm", "label": "pwm", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "wave", "label": "wave", "options": ["sine", "triangle", "saw", "square"], "default": 2},
    {"name": "tune", "label": "tune", "min": -24, "max": 24, "default": 0, "warp": "lin", "units": "st"},
    {"name": "fine", "label": "fine", "min": -50, "max": 50, "default": 0, "warp": "lin", "units": "ct"},
    {"name": "pw", "label": "width", "min": 0.05, "max": 0.95, "default": 0.5, "warp": "lin"},
    {"name": "fm", "label": "fm depth", "min": 0, "max": 48, "default": 0, "warp": "lin", "units": "st"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "supersaw", "label": "supersaw", "group": "source", "about": "seven detuned saws: big leads and pads",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "tune", "label": "tune", "min": -24, "max": 24, "default": 0, "warp": "lin", "units": "st"},
    {"name": "detune", "label": "detune", "min": 0, "max": 1, "default": 0.25, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "fmop", "label": "fm operator", "group": "source", "about": "a sine at a ratio of the pitch; another operator into pm makes bells and keys",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}, {"name": "pm", "label": "pm", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "ratio", "label": "ratio", "min": 0.25, "max": 16, "default": 1, "warp": "exp"},
    {"name": "fine", "label": "fine", "min": -50, "max": 50, "default": 0, "warp": "lin", "units": "ct"},
    {"name": "index", "label": "pm depth", "min": 0, "max": 10, "default": 2, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "noise", "label": "noise", "group": "source", "about": "white, pink or brown noise",
   "inputs": [],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "color", "label": "color", "options": ["white", "pink", "brown"], "default": 0},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "string", "label": "string", "group": "source", "about": "a plucked string (Karplus-Strong), struck by the gate",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}, {"name": "trig", "label": "strike", "default": "voice.gate"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "decay", "label": "decay", "min": 0.1, "max": 10, "default": 2, "warp": "exp", "units": "s"},
    {"name": "damp", "label": "damp", "min": 0, "max": 0.95, "default": 0.3, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "formant", "label": "vowel", "group": "source", "about": "a voice-like tone that sings a, e, i, o, u (in between too)",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}, {"name": "vowel", "label": "vowel", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "vowel", "label": "vowel", "min": 0, "max": 4, "default": 0, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "sample", "label": "sample", "group": "source", "about": "plays a sound file loaded into a slot (the \"load sample\" block), at the pitch of the note",
   "inputs": [{"name": "pitch", "label": "pitch", "default": "voice.pitch"}, {"name": "trig", "label": "start", "default": "voice.gate"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "slot", "label": "slot", "min": 1, "max": 8, "default": 1, "warp": "lin", "step": 1},
    {"name": "start", "label": "start", "min": 0, "max": 1, "default": 0, "warp": "lin"},
    {"name": "end", "label": "end", "min": 0, "max": 1, "default": 1, "warp": "lin"},
    {"name": "loop", "label": "loop", "options": ["off", "on"], "default": 0},
    {"name": "track", "label": "follow pitch", "min": 0, "max": 1, "default": 1, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},

  {"type": "filter", "label": "filter", "group": "shape", "about": "lowpass, highpass, bandpass or notch; mod moves the cutoff in octaves",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}, {"name": "mod", "label": "mod", "default": "zero"}, {"name": "pitch", "label": "key", "default": "voice.pitch"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "type", "label": "type", "options": ["lowpass", "highpass", "bandpass", "notch"], "default": 0},
    {"name": "cutoff", "label": "cutoff", "min": 20, "max": 18000, "default": 1200, "warp": "exp", "units": "Hz"},
    {"name": "res", "label": "resonance", "min": 0, "max": 1, "default": 0.2, "warp": "lin"},
    {"name": "mod", "label": "mod depth", "min": -8, "max": 8, "default": 2, "warp": "lin", "units": "oct"},
    {"name": "track", "label": "key follow", "min": 0, "max": 1, "default": 0, "warp": "lin"}]},
  {"type": "vca", "label": "amp", "group": "shape", "about": "the in signal, as loud as the cv input says (an envelope, usually)",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}, {"name": "cv", "label": "cv", "default": "one"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [{"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "mixer", "label": "mixer", "group": "shape", "about": "four inputs into one",
   "inputs": [{"name": "in1", "label": "in 1", "default": "zero"}, {"name": "in2", "label": "in 2", "default": "zero"}, {"name": "in3", "label": "in 3", "default": "zero"}, {"name": "in4", "label": "in 4", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "l1", "label": "level 1", "min": 0, "max": 1, "default": 1, "warp": "lin"},
    {"name": "l2", "label": "level 2", "min": 0, "max": 1, "default": 1, "warp": "lin"},
    {"name": "l3", "label": "level 3", "min": 0, "max": 1, "default": 1, "warp": "lin"},
    {"name": "l4", "label": "level 4", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "drive", "label": "drive", "group": "shape", "about": "soft saturation, wavefolding or hard clipping",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}, {"name": "mod", "label": "mod", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "type", "label": "type", "options": ["saturate", "fold", "clip"], "default": 0},
    {"name": "amount", "label": "amount", "min": 1, "max": 20, "default": 2, "warp": "exp"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 0.7, "warp": "lin"}]},
  {"type": "crush", "label": "bitcrush", "group": "shape", "about": "fewer bits and a lower sample rate: lo-fi",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "bits", "label": "bits", "min": 1, "max": 16, "default": 6, "warp": "lin"},
    {"name": "rate", "label": "rate", "min": 200, "max": 48000, "default": 8000, "warp": "exp", "units": "Hz"}]},
  {"type": "comb", "label": "resonator", "group": "shape", "about": "a tuned comb: rings the in signal at the note's pitch (try noise in)",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}, {"name": "pitch", "label": "pitch", "default": "voice.pitch"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "tune", "label": "tune", "min": -24, "max": 24, "default": 0, "warp": "lin", "units": "st"},
    {"name": "decay", "label": "decay", "min": 0.01, "max": 8, "default": 1, "warp": "exp", "units": "s"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 0.5, "warp": "lin"}]},
  {"type": "ring", "label": "ring mod", "group": "shape", "about": "a times b",
   "inputs": [{"name": "a", "label": "a", "default": "zero"}, {"name": "b", "label": "b", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": []},
  {"type": "slew", "label": "slew", "group": "shape", "about": "smooths changes: steps become glides",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [{"name": "time", "label": "time", "min": 0, "max": 2, "default": 0.1, "warp": "lin", "units": "s"}]},
  {"type": "scale", "label": "scale + offset", "group": "shape", "about": "in times amount, plus offset: turn a modulation up, down or upside down",
   "inputs": [{"name": "in", "label": "in", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "amount", "label": "amount", "min": -4, "max": 4, "default": 1, "warp": "lin"},
    {"name": "offset", "label": "offset", "min": -1, "max": 1, "default": 0, "warp": "lin"}]},

  {"type": "env", "label": "envelope", "group": "mod", "about": "attack, decay, sustain, release while the gate is held; 0 to 1",
   "inputs": [{"name": "gate", "label": "gate", "default": "voice.gate"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "a", "label": "attack", "min": 0.001, "max": 10, "default": 0.005, "warp": "exp", "units": "s"},
    {"name": "d", "label": "decay", "min": 0.001, "max": 10, "default": 0.3, "warp": "exp", "units": "s"},
    {"name": "s", "label": "sustain", "min": 0, "max": 1, "default": 0.6, "warp": "lin"},
    {"name": "r", "label": "release", "min": 0.001, "max": 10, "default": 0.5, "warp": "exp", "units": "s"},
    {"name": "curve", "label": "curve", "min": -8, "max": 8, "default": -4, "warp": "lin"},
    {"name": "vel", "label": "velocity", "min": 0, "max": 1, "default": 0.5, "warp": "lin"}]},
  {"type": "lfo", "label": "lfo", "group": "mod", "about": "a slow wave, -1 to 1, started with each note",
   "inputs": [{"name": "rate", "label": "rate mod", "default": "zero"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "wave", "label": "wave", "options": ["sine", "triangle", "saw", "square", "random"], "default": 0},
    {"name": "rate", "label": "rate", "min": 0.01, "max": 40, "default": 2, "warp": "exp", "units": "Hz"},
    {"name": "level", "label": "depth", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "sh", "label": "sample + hold", "group": "mod", "about": "holds a new random value (or the in signal) at each tick: random steps",
   "inputs": [{"name": "in", "label": "in", "default": "noise"}],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [{"name": "rate", "label": "rate", "min": 0.1, "max": 40, "default": 4, "warp": "exp", "units": "Hz"}]},
  {"type": "drift", "label": "drift", "group": "mod", "about": "wanders slowly and smoothly, -1 to 1: life for pads and tuning",
   "inputs": [],
   "outputs": [{"name": "out", "label": "out"}],
   "params": [
    {"name": "rate", "label": "rate", "min": 0.01, "max": 20, "default": 0.3, "warp": "exp", "units": "Hz"},
    {"name": "level", "label": "depth", "min": 0, "max": 1, "default": 1, "warp": "lin"}]}
 ],
 "fx": [
  {"type": "main", "label": "main", "group": "fixed", "about": "the line input into the effects, and the level of everything",
   "params": [
    {"name": "input", "label": "line in", "min": 0, "max": 1, "default": 0, "warp": "lin"},
    {"name": "level", "label": "level", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "fx_filter", "label": "filter", "group": "fx", "about": "a filter over everything",
   "params": [
    {"name": "type", "label": "type", "options": ["lowpass", "highpass"], "default": 0},
    {"name": "cutoff", "label": "cutoff", "min": 20, "max": 18000, "default": 8000, "warp": "exp", "units": "Hz"},
    {"name": "res", "label": "resonance", "min": 0, "max": 1, "default": 0.1, "warp": "lin"}]},
  {"type": "fx_drive", "label": "drive", "group": "fx", "about": "saturation over everything",
   "params": [
    {"name": "amount", "label": "amount", "min": 1, "max": 20, "default": 2, "warp": "exp"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "fx_crush", "label": "bitcrush", "group": "fx", "about": "lo-fi over everything",
   "params": [
    {"name": "bits", "label": "bits", "min": 1, "max": 16, "default": 8, "warp": "lin"},
    {"name": "rate", "label": "rate", "min": 200, "max": 48000, "default": 12000, "warp": "exp", "units": "Hz"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 1, "warp": "lin"}]},
  {"type": "fx_tape", "label": "tape", "group": "fx", "about": "wow, flutter and tape saturation",
   "params": [
    {"name": "wow", "label": "wow", "min": 0, "max": 1, "default": 0.3, "warp": "lin"},
    {"name": "flutter", "label": "flutter", "min": 0, "max": 1, "default": 0.2, "warp": "lin"},
    {"name": "drive", "label": "saturation", "min": 0, "max": 1, "default": 0.3, "warp": "lin"}]},
  {"type": "fx_chorus", "label": "chorus", "group": "fx", "about": "a slowly moving copy next to the sound",
   "params": [
    {"name": "rate", "label": "rate", "min": 0.05, "max": 5, "default": 0.4, "warp": "exp", "units": "Hz"},
    {"name": "depth", "label": "depth", "min": 0, "max": 1, "default": 0.4, "warp": "lin"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.4, "warp": "lin"}]},
  {"type": "fx_phaser", "label": "phaser", "group": "fx", "about": "sweeping notches",
   "params": [
    {"name": "rate", "label": "rate", "min": 0.02, "max": 5, "default": 0.2, "warp": "exp", "units": "Hz"},
    {"name": "depth", "label": "depth", "min": 0, "max": 1, "default": 0.6, "warp": "lin"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.5, "warp": "lin"}]},
  {"type": "fx_pitch", "label": "pitch shift", "group": "fx", "about": "a copy shifted up or down (octaves, fifths)",
   "params": [
    {"name": "semis", "label": "shift", "min": -24, "max": 24, "default": 12, "warp": "lin", "units": "st"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.3, "warp": "lin"}]},
  {"type": "fx_grains", "label": "grains", "group": "fx", "about": "scatters the sound into a cloud of small grains",
   "params": [
    {"name": "density", "label": "density", "min": 1, "max": 80, "default": 15, "warp": "exp", "units": "/s"},
    {"name": "size", "label": "size", "min": 0.01, "max": 0.5, "default": 0.12, "warp": "exp", "units": "s"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.4, "warp": "lin"}]},
  {"type": "fx_delay", "label": "delay", "group": "fx", "about": "echoes; spread puts the right side later",
   "params": [
    {"name": "time", "label": "time", "min": 0.01, "max": 2, "default": 0.375, "warp": "exp", "units": "s"},
    {"name": "feedback", "label": "feedback", "min": 0, "max": 0.95, "default": 0.4, "warp": "lin"},
    {"name": "tone", "label": "tone", "min": 200, "max": 18000, "default": 4000, "warp": "exp", "units": "Hz"},
    {"name": "spread", "label": "spread", "min": 0, "max": 1, "default": 0.3, "warp": "lin"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.25, "warp": "lin"}]},
  {"type": "fx_reverb", "label": "reverb", "group": "fx", "about": "a room to a hall",
   "params": [
    {"name": "size", "label": "size", "min": 0, "max": 1, "default": 0.7, "warp": "lin"},
    {"name": "damp", "label": "damp", "min": 0, "max": 1, "default": 0.5, "warp": "lin"},
    {"name": "mix", "label": "mix", "min": 0, "max": 1, "default": 0.25, "warp": "lin"}]},
  {"type": "fx_comp", "label": "compressor", "group": "fx", "about": "evens out the level: punch, or glue",
   "params": [
    {"name": "threshold", "label": "threshold", "min": 0.01, "max": 1, "default": 0.3, "warp": "exp"},
    {"name": "ratio", "label": "ratio", "min": 1, "max": 20, "default": 4, "warp": "exp"},
    {"name": "gain", "label": "makeup", "min": 0.5, "max": 4, "default": 1.5, "warp": "exp"}]},
  {"type": "fx_width", "label": "width", "group": "fx", "about": "narrower (0) or wider (2) stereo",
   "params": [{"name": "width", "label": "width", "min": 0, "max": 2, "default": 1.4, "warp": "lin"}]}
 ]
}
