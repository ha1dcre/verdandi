from waflib.TaskGen import extension

@extension('.m')
def objc_file(self, node):
    # the macOS menu bar and app input (matron/src/platform/macos/*.m): a c task, clang
    # compiles it as objective-c by its extension
    return self.create_compiled_task('c', node)

