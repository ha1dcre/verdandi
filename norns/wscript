        '../matron/src/time_since.cc',
    ]

    if bld.env.NORNS_DESKTOP:
        matron_sources += [
            '../matron/src/hardware/screen/sdl.cc',
            '../matron/src/hardware/input/sdl.cc',
        ]

    crone_sources = [
        '../crone/src/crone_param_dispatch.cpp',
        '../crone/src/crone.cpp',
        '../crone/src/main.cpp',
        '../crone/src/BufDiskWorker.cpp',
        '../crone/src/Commands.cpp',
        '../crone/src/MixerClient.cpp',
        '../crone/src/OscInterface.cpp',
        '../crone/src/SoftcutClient.cpp',
        '../crone/src/Taper.cpp',
        '../crone/src/Window.cpp',
        '../crone/softcut/softcut-lib/src/FadeCurves.cpp',
        '../crone/softcut/softcut-lib/src/ReadWriteHead.cpp',
        '../crone/softcut/softcut-lib/src/SubHead.cpp',
        '../crone/softcut/softcut-lib/src/Svf.cpp',
        '../crone/softcut/softcut-lib/src/Voice.cpp'
    ]

    matron_includes = [
        '../matron/src',
        '../matron/src/device',
        '../matron/src/hardware',
    ]

    matron_libs = [
        'pthread',
        'm',
    ]

    matron_use = [
        'ALSA',
        'LIBUDEV',
        'LIBEVDEV',
        'LIBGPIOD',
        'CAIRO',
        'CAIRO-FT',
        'LUA53',
        'LIBLO',
        'LIBMONOME',
        'NNG',
        'ATOMIC',
        'SNDFILE',
        'AVAHI-COMPAT-LIBDNS_SD',
        'JACK',
    ]

    if bld.env.NORNS_DESKTOP:
        matron_libs.append('SDL2')
        matron_use.append('SDL2')

    if bld.env.ENABLE_ABLETON_LINK:
        matron_sources += ['../matron/src/clocks/clock_link.cc']
        matron_includes += ['../third-party/link/extensions/abl_link/include']
        matron_libs += ['stdc++']
        matron_use += ['LIBLINK_C']

    if bld.env.ENABLE_LUA_CJSON:
        matron_use.append('LUA_CJSON')

    crone_includes=[
        '../third-party/concurrentqueue',
        '../third-party/readerwriterqueue',
        '../crone',
        '../crone/src',
        '../crone/softcut/softcut-lib/include'
    ]

    crone_use=[
        'ALSA',
        'LIBLO',
    ]

    crone_libs=[
        'jack',
        'pthread',
        'm',
        'sndfile'
    ]

    norns_sources = [
        'main.cpp',
        'sidecar.cpp',
        'sidecar_lines.cpp',
        'sidecar_msg.cpp',
        'sidecar_shell.cpp'
    ]

    norns_libs = [
    ]

    if bld.env.NORNS_MACOS:
        # pi hardware and the linux device layer are replaced by platform/macos
        replaced = [
            '../matron/src/device/device_hid.cc',
            '../matron/src/device/device_monitor.cc',
            '../matron/src/hardware/battery.cc',
            '../matron/src/hardware/i2c.cc',
            '../matron/src/hardware/screen/ssd1322.cc',
            '../matron/src/hardware/input/gpio.cc',
            '../matron/src/hardware/stat.cc',
        ]
        matron_sources = [f for f in matron_sources if f not in replaced] + [
            '../matron/src/platform/macos/app_audio.m',
            '../matron/src/platform/macos/device_hid_iohid.cc',
            '../matron/src/platform/macos/device_monitor_macos.cc',
            '../matron/src/platform/macos/device_skin.c',
            '../matron/src/platform/macos/device_runloop.cc',
            '../matron/src/platform/macos/dust_import.c',
            '../matron/src/platform/macos/gif_writer.c',
            '../matron/src/platform/macos/hardware_null.cc',
            '../matron/src/platform/macos/mac_menu.m',
            '../matron/src/platform/macos/mac_update.m',
            '../matron/src/platform/macos/open_url.c',
            '../matron/src/platform/macos/sdl_bridge.cc',
            '../matron/src/platform/macos/stat_macos.cc',
            '../matron/src/platform/macos/varc_skin.c',
            '../matron/src/platform/macos/vgrid_device.c',
            '../matron/src/platform/macos/vgrid_proto.c',
            '../matron/src/platform/macos/vgrid_skin.c',
            '../matron/src/platform/macos/vkeys_skin.c',
            '../matron/src/platform/macos/window_keys.c',
        ]
        linux_only = ['ALSA', 'LIBUDEV', 'LIBEVDEV', 'LIBGPIOD', 'AVAHI-COMPAT-LIBDNS_SD', 'ATOMIC']
        matron_use = [u for u in matron_use if u not in linux_only]
        crone_use = [u for u in crone_use if u not in linux_only]
        matron_includes += ['../matron/src/platform/macos/include']

    norns_sources = norns_sources + matron_sources + crone_sources
    norns_includes = ['.'] + matron_includes + crone_includes
    norns_use = matron_use + crone_use
    norns_libs = norns_libs + matron_libs + crone_libs
    norns_cxxflags = ['-O3', '-Wall', '-mfpu=neon']
    norns_ldflags = ['-Wl,-export-dynamic']
    norns_frameworks = []

    if bld.env.NORNS_MACOS:
        compat = bld.path.find_node('../matron/src/platform/macos/compat.h').abspath()
        norns_cxxflags = ['-O3', '-Wall', '-include', compat]
        # darwin executables export their symbols by default (lua c modules resolve against them);
        # header padding lets macos/make-app.sh rewrite library paths
        norns_ldflags = ['-Wl,-headerpad_max_install_names']
        norns_frameworks = ['AppKit', 'CoreAudio', 'CoreFoundation', 'CoreMIDI', 'IOKit', 'UniformTypeIdentifiers']

    if bld.env.NORNS_PROFILE:
        norns_cxxflags += ['-pg']
        norns_ldflags += ['-pg']

    if bld.env.NORNS_DEBUG:
        norns_cxxflags += ['-g']

    if bld.env.NORNS_RELEASE:
        norns_cxxflags += [
            '-mcpu=cortex-a53',
            '-mtune=cortex-a53',
            '-mfpu=neon-fp-armv8',
            '-mfloat-abi=hard',
            '-funconstrained-commons',
            '-ffast-math',
            '-fgcse-sm',
        ]

    if bld.env.NORNS_MACOS:
        # compat.h is force-included, so the dependency scanner never sees it
        compat_node = bld.path.find_node('../matron/src/platform/macos/compat.h')
        for src in norns_sources:
            bld.add_manual_dependency(bld.path.find_node(src), compat_node)

    bld.program(features='c cprogram cxx cxxprogram',
        target='norns',
        source=norns_sources,
        includes=norns_includes,
        use=norns_use,
        lib=norns_libs,
        cxxflags=norns_cxxflags,
        ldflags=norns_ldflags,
        framework=norns_frameworks)
